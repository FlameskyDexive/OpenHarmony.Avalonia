<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AvaloniaApp.ViewModels"
             xmlns:openHarmony="clr-namespace:Avalonia.OpenHarmony;assembly=Avalonia.OpenHarmony"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="AvaloniaApp.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>
    <Grid Margin="40" RowDefinitions="*,Auto">

        <!-- PandaGit brand welcome page -->
        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="14" MaxWidth="820">
                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,12,0,0">
                    <Border Width="76" Height="76" CornerRadius="18" Background="#2D7DFA">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="PG" FontSize="30" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="PandaGit" FontSize="42" FontWeight="Bold" Foreground="#1F2430"/>
                        <TextBlock Text="OpenSource GIT client — Avalonia + C# NativeAOT on OpenHarmony" FontSize="15" Foreground="#5A6472"/>
                    </StackPanel>
                </StackPanel>

                <Border CornerRadius="10" Background="#E8F0FE" Padding="14,7" HorizontalAlignment="Left">
                    <TextBlock Text="v2026.24 · net9.0 · linux-musl-x64 · HarmonyOS Emulator" FontSize="13" Foreground="#2D7DFA"/>
                </Border>

                <Border CornerRadius="14" Background="#F5F7FA" Padding="18" Margin="0,8,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Welcome" FontSize="18" FontWeight="SemiBold" Foreground="#1F2430"/>
                        <TextBlock FontSize="14" Foreground="#5A6472" TextWrapping="Wrap"
                                   Text="This page is drawn by Avalonia (Skia + EGL via XComponent), compiled from C# with NativeAOT cross-compiled from Windows using Zig. The whole UI stack — layouts, styles, text, input — is the same framework PandaGit uses on desktop."/>
                    </StackPanel>
                </Border>

                <Border CornerRadius="14" Background="#F5F7FA" Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Repositories" FontSize="18" FontWeight="SemiBold" Foreground="#1F2430"/>
                        <Border BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="10" Padding="14,18">
                            <StackPanel HorizontalAlignment="Center" Spacing="6">
                                <TextBlock Text="DRAG &amp; DROP FOLDER SUPPORTED." FontSize="13" FontStyle="Italic" Foreground="#8A93A3" HorizontalAlignment="Center"/>
                                <TextBlock Text="CUSTOM GROUPING SUPPORTED." FontSize="13" FontStyle="Italic" Foreground="#8A93A3" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock FontSize="12" Foreground="#98A1B0" TextWrapping="Wrap"
                                   Text="(Demo page — actual repository features are blocked on HarmonyOS: app sandbox cannot execute the external git binary.)"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Diagnostics: IME test + runtime log -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" Margin="0,10,0,0">
            <TextBox Grid.Row="0"
                     Watermark="IME / TextInput test..."
                     TextInput="InputElement_OnTextInput"
                     TextInputMethodClientRequested="InputElement_OnTextInputMethodClientRequested" />
            <ListBox Grid.Row="1" Height="120" Margin="0,8,0,0"
                     ItemsSource="{x:Static openHarmony:OHDebugHelper.Logs}" />
        </Grid>
    </Grid>
</UserControl>
